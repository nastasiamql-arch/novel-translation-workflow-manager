{
  "name": "novelworkflow-vscode",
  "displayName": "NovelWorkflow",
  "description": "Manage novel projects and translation workflows inside Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "nastasiamql-arch",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "keywords": ["novel", "translation", "workflow"],
  "main": "./src/extension.js",
  "activationEvents": ["onView:novelWorkflow.profiles", "onStartupFinished"],
  "scripts": { "test": "node --test", "check": "node --check src/extension.js && node --check src/core.js && node --check src/clipboard.js && node --test" },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "novelWorkflow", "title": "NovelWorkflow", "icon": "media/icon.svg" }] },
    "views": { "novelWorkflow": [{ "id": "novelWorkflow.profiles", "name": "นิยายและขั้นตอน", "contextualTitle": "NovelWorkflow" }] },
    "commands": [
      { "command": "novelWorkflow.refresh", "title": "NovelWorkflow: Refresh" },
      { "command": "novelWorkflow.createProfile", "title": "NovelWorkflow: Create Novel" },
      { "command": "novelWorkflow.selectProfile", "title": "NovelWorkflow: Select Novel" },
      { "command": "novelWorkflow.renameProfile", "title": "NovelWorkflow: Rename Novel" },
      { "command": "novelWorkflow.duplicateProfile", "title": "NovelWorkflow: Duplicate Novel" },
      { "command": "novelWorkflow.deleteProfile", "title": "NovelWorkflow: Delete Novel" },
      { "command": "novelWorkflow.openProfile", "title": "NovelWorkflow: Open Novel Folder" },
      { "command": "novelWorkflow.openProfileManager", "title": "NovelWorkflow: Open Novel Files" },
      { "command": "novelWorkflow.setChapter", "title": "NovelWorkflow: Set Current Chapter" },
      { "command": "novelWorkflow.addStep", "title": "NovelWorkflow: Add Workflow Step" },
      { "command": "novelWorkflow.renameStep", "title": "NovelWorkflow: Rename Workflow Step" },
      { "command": "novelWorkflow.duplicateStep", "title": "NovelWorkflow: Duplicate Workflow Step" },
      { "command": "novelWorkflow.deleteStep", "title": "NovelWorkflow: Delete Workflow Step" },
      { "command": "novelWorkflow.moveStepUp", "title": "NovelWorkflow: Move Step Up" },
      { "command": "novelWorkflow.moveStepDown", "title": "NovelWorkflow: Move Step Down" },
      { "command": "novelWorkflow.addFiles", "title": "NovelWorkflow: Add Files to Step" },
      { "command": "novelWorkflow.addDynamicFile", "title": "NovelWorkflow: Add Dynamic Chapter File" },
      { "command": "novelWorkflow.toggleFile", "title": "NovelWorkflow: Enable or Disable Step File" },
      { "command": "novelWorkflow.removeFile", "title": "NovelWorkflow: Remove File from Step" },
      { "command": "novelWorkflow.openFile", "title": "NovelWorkflow: Open File" },
      { "command": "novelWorkflow.copyStep", "title": "NovelWorkflow: Copy Step Files" },
      { "command": "novelWorkflow.previewStep", "title": "NovelWorkflow: Preview Step Contents" },
      { "command": "novelWorkflow.createFile", "title": "NovelWorkflow: Create Text File" },
      { "command": "novelWorkflow.importFile", "title": "NovelWorkflow: Import File into Novel" },
      { "command": "novelWorkflow.searchProjectFiles", "title": "NovelWorkflow: Search Novel Files" },
      { "command": "novelWorkflow.renameFileLabel", "title": "NovelWorkflow: Rename File Label in Step" },
      { "command": "novelWorkflow.moveFileUp", "title": "NovelWorkflow: Move File Up" },
      { "command": "novelWorkflow.moveFileDown", "title": "NovelWorkflow: Move File Down" },
      { "command": "novelWorkflow.replaceStepFile", "title": "NovelWorkflow: Replace Step File Reference" },
      { "command": "novelWorkflow.deleteProjectFile", "title": "NovelWorkflow: Delete Actual Project File" },
      { "command": "novelWorkflow.createWorkflowTemplate", "title": "NovelWorkflow: Save Workflow as Template" },
      { "command": "novelWorkflow.applyWorkflowTemplate", "title": "NovelWorkflow: Apply Workflow Template" },
      { "command": "novelWorkflow.setContextFile", "title": "NovelWorkflow: Select Context File" },
      { "command": "novelWorkflow.setCover", "title": "NovelWorkflow: Set Novel Cover" },
      { "command": "novelWorkflow.removeCover", "title": "NovelWorkflow: Remove Novel Cover" },
      { "command": "novelWorkflow.setGoal", "title": "NovelWorkflow: Set Chapter Goal" },
      { "command": "novelWorkflow.resetGoal", "title": "NovelWorkflow: Reset Chapter Goal Progress" },
      { "command": "novelWorkflow.showProgress", "title": "NovelWorkflow: Show Translation Progress" },
      { "command": "novelWorkflow.manageGroups", "title": "NovelWorkflow: Manage Novel Groups" },
      { "command": "novelWorkflow.renameGroup", "title": "NovelWorkflow: Rename Novel Group" },
      { "command": "novelWorkflow.deleteGroup", "title": "NovelWorkflow: Delete Novel Group" },
      { "command": "novelWorkflow.importLauncher", "title": "NovelWorkflow: Import Novel Launcher Data" },
      { "command": "novelWorkflow.addGroup", "title": "NovelWorkflow: Create Group" },
      { "command": "novelWorkflow.openGroup", "title": "NovelWorkflow: Open Group" },
      { "command": "novelWorkflow.addLaunchTarget", "title": "NovelWorkflow: Add Launcher Target" }
      ,{ "command": "novelWorkflow.manageLaunchTargets", "title": "NovelWorkflow: Manage Launcher Targets" }
    ],
    "menus": {
      "view/title": [
        { "command": "novelWorkflow.createProfile", "when": "view == novelWorkflow.profiles", "group": "navigation" },
        { "command": "novelWorkflow.addGroup", "when": "view == novelWorkflow.profiles", "group": "navigation" },
        { "command": "novelWorkflow.importLauncher", "when": "view == novelWorkflow.profiles", "group": "navigation" },
        { "command": "novelWorkflow.showProgress", "when": "view == novelWorkflow.profiles", "group": "navigation" },
        { "command": "novelWorkflow.manageGroups", "when": "view == novelWorkflow.profiles", "group": "navigation" },
        { "command": "novelWorkflow.refresh", "when": "view == novelWorkflow.profiles", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "novelWorkflow.openProfile", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "inline@1" },
        { "command": "novelWorkflow.openProfileManager", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "inline@2" },
        { "command": "novelWorkflow.addStep", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@1" },
        { "command": "novelWorkflow.setChapter", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@2" },
        { "command": "novelWorkflow.setGoal", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@2" },
        { "command": "novelWorkflow.resetGoal", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@2" },
        { "command": "novelWorkflow.setContextFile", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@2" },
        { "command": "novelWorkflow.setCover", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@2" },
        { "command": "novelWorkflow.removeCover", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@2" },
        { "command": "novelWorkflow.manageLaunchTargets", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@3" },
        { "command": "novelWorkflow.applyWorkflowTemplate", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@3" },
        { "command": "novelWorkflow.renameProfile", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@3" },
        { "command": "novelWorkflow.duplicateProfile", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@4" },
        { "command": "novelWorkflow.deleteProfile", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@5" },
        { "command": "novelWorkflow.copyStep", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@1" },
        { "command": "novelWorkflow.previewStep", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@2" },
        { "command": "novelWorkflow.addFiles", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@3" },
        { "command": "novelWorkflow.addDynamicFile", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@4" },
        { "command": "novelWorkflow.createWorkflowTemplate", "when": "view == novelWorkflow.profiles && viewItem == novelProfile", "group": "profile@6" },
        { "command": "novelWorkflow.renameStep", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@5" },
        { "command": "novelWorkflow.duplicateStep", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@6" },
        { "command": "novelWorkflow.deleteStep", "when": "view == novelWorkflow.profiles && viewItem == novelStep", "group": "step@7" },
        { "command": "novelWorkflow.toggleFile", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@1" },
        { "command": "novelWorkflow.openFile", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@2" },
        { "command": "novelWorkflow.removeFile", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@3" },
        { "command": "novelWorkflow.renameFileLabel", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@4" },
        { "command": "novelWorkflow.replaceStepFile", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@5" },
        { "command": "novelWorkflow.moveFileUp", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@6" },
        { "command": "novelWorkflow.moveFileDown", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@7" },
        { "command": "novelWorkflow.deleteProjectFile", "when": "view == novelWorkflow.profiles && viewItem == novelStepFile", "group": "file@8" },
        { "command": "novelWorkflow.openGroup", "when": "view == novelWorkflow.profiles && viewItem == novelGroup", "group": "inline@1" },
        { "command": "novelWorkflow.renameGroup", "when": "view == novelWorkflow.profiles && viewItem == novelGroup", "group": "group@1" },
        { "command": "novelWorkflow.deleteGroup", "when": "view == novelWorkflow.profiles && viewItem == novelGroup", "group": "group@2" }
      ]
    },
    "keybindings": [
      { "command": "novelWorkflow.copyStep", "key": "ctrl+shift+c", "when": "focusedView == novelWorkflow.profiles && !terminalFocus" },
      { "command": "novelWorkflow.previewStep", "key": "ctrl+p", "when": "focusedView == novelWorkflow.profiles && !terminalFocus" },
      { "command": "novelWorkflow.refresh", "key": "ctrl+r", "when": "focusedView == novelWorkflow.profiles && !terminalFocus" }
    ],
    "configuration": {
      "title": "NovelWorkflow",
      "properties": {
        "novelWorkflow.dataRoot": { "type": "string", "default": "", "description": "Optional profile data folder. Empty uses the existing NovelWorkflow LocalAppData folder." },
        "novelWorkflow.separator": { "type": "string", "default": "==============================\\n{FILE_NAME}\\n==============================", "description": "File heading used in the text preview. {FILE_NAME} is replaced with the display label." },
        "novelWorkflow.showFilenameHeading": { "type": "boolean", "default": true, "description": "Show file labels in preview." },
        "novelWorkflow.confirmBeforeDelete": { "type": "boolean", "default": true, "description": "Confirm destructive profile and workflow actions." },
        "novelWorkflow.openLastProfile": { "type": "boolean", "default": true, "description": "Reopen the last selected profile." }
      }
    }
  }
}
